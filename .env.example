BOT_TOKEN=
STORAGE_CHAT_ID=

# VK Music access token (Kate Mobile flow). Optional but strongly
# recommended — VK is the primary audio source. Without it the bot
# falls back to YouTube/yt-dlp, which gets rate-limited on data centers.
# Grab one at https://vkhost.github.io/ → Kate Mobile → log in → copy
# the access_token from the redirect URL.
VK_TOKEN=

# Set to "1" to disable the YouTube/yt-dlp fallback entirely.
DISABLE_YOUTUBE_FALLBACK=

# Optional cookies for yt-dlp (Netscape format). Pick ONE:
# YT_COOKIES_B64= (base64-encoded; preferred — survives shell escaping)
# YT_COOKIES=     (raw text; may break on multiline shell args)
