BOT_TOKEN=
STORAGE_CHAT_ID=

# Pick ONE of the two VK auth paths below.
#
# === Path 1: browser cookies (preferred — bypasses password flow) ===
# 1. Open vk.com in your browser, make sure you're logged in.
# 2. Install "Get cookies.txt LOCALLY" extension, click on vk.com,
#    Export As → save as `vk_cookies.txt`.
# 3. Get base64: PowerShell:
#    [Convert]::ToBase64String([IO.File]::ReadAllBytes('vk_cookies.txt'))
# 4. Find your numeric user id: open vk.com/edit — URL shows e.g.
#    https://vk.com/edit12345678 → VK_USER_ID=12345678.
VK_COOKIES_B64=
VK_USER_ID=
#
# === Path 2: direct-auth Kate Mobile token (legacy) ===
# `python scripts/get_vk_audio_token.py` — works only when VK's
# password-bruteforce flood control is not active on your account.
VK_TOKEN=
